# Copy to .env.local and fill in. Never commit real values.

# 32-byte key, base64. Generate with: npm run gen-key
ENCRYPTION_KEY=

# Production: a Postgres URL (postgresql://...).
# Leave empty locally: the app then uses PGlite (Postgres in WebAssembly), stored in ./.pglite
DATABASE_URL=

# Optional. Without it, a rule-based extractor is used instead of the LLM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Only for models that refuse a forced tool call (claude-sonnet-5-5 does): set to auto.
ANTHROPIC_TOOL_CHOICE=

# Optional. With a key, a plan created with a location gets its candidate
# restaurants from Google Places (API "New"); without one, the seed pool is used.
GOOGLE_PLACES_API_KEY=

# With ANTHROPIC_API_KEY set, each person's agent and the mediator are LLM-driven
# (hard rules are still enforced in code). Set to 0 to use the code-only negotiation.
SETTLE_LLM_NEGOTIATION=

# Optional. Set to 1 (with ANTHROPIC_API_KEY) to use only the LLM proposer, even when
# SETTLE_LLM_NEGOTIATION=0.
SETTLE_LLM_MEDIATOR=

# Optional, LOCAL DEVELOPMENT ONLY. A folder holding yelp_academic_dataset_business.json
# from the Yelp Open Dataset. Plans created in one of its cities ("Philadelphia") then get
# real restaurants for free, with no API key. Only works under `npm run dev`: it is ignored
# in production builds and on Vercel, because the dataset may not be redistributed.
# See sim/yelp/README.md.
YELP_DATASET_DIR=
