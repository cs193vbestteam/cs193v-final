{
  "name": "settle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "description": "Group plans without the group-chat drama: everyone tells their own assistant their real constraints in private, and the assistants negotiate a plan that works for everyone.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim": "tsx sim/run.ts",
    "sim:study": "node --env-file-if-exists=.env.local --import tsx sim/study-run.ts",
    "sim:extract": "node --env-file-if-exists=.env.local --require ./sim/shims/server-only.cjs --import tsx sim/extract-eval-run.ts",
    "sim:yelp": "tsx sim/yelp/run.ts",
    "sample:places": "node --env-file-if-exists=.env.local --require ./sim/shims/server-only.cjs --import tsx sim/places-sample.ts",
    "cases:optimizer": "node --env-file-if-exists=.env.local --require ./sim/shims/server-only.cjs --import tsx sim/optimizer-cases.ts",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"",
    "migrate:encryption": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-encryption.ts",
    "personas": "node --require ./sim/shims/server-only.cjs --import tsx sim/personas.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "bcryptjs": "^3.0.3",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
